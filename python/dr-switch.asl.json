{
  "Comment": "DR 切替ワークフロー。実行するのは常に「これから ACTIVE になる側」のリージョン。切替方向は、どのリージョンのステートマシンを起動したかで決まる（入力に direction を持たない）。",
  "QueryLanguage": "JSONata",
  "StartAt": "FenceApiGw",
  "TimeoutSeconds": 1800,
  "States": {

    "FenceApiGw": {
      "Comment": "旧 ACTIVE（PEER）のスロットリングを 0 にして閉塞する。リージョン障害中は失敗しうるためベストエフォート。",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_apigw_function_arn}",
        "Payload": {
          "role": "peer",
          "blocked": true,
          "dry_run": "{% $states.context.Execution.Input.dry_run %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["RetryableError"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        },
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "Comment": "閉塞失敗は握りつぶさず記録して続行する。PEER が落ちていれば当然失敗するため。",
          "ErrorEquals": ["ContinuableError"],
          "Next": "FenceScheduler",
          "Output": { "fenceApiGwError": "{% $states.errorOutput %}" }
        }
      ],
      "Next": "FenceScheduler"
    },

    "FenceScheduler": {
      "Comment": "旧 ACTIVE（PEER）の EventBridge Scheduler を停止する。",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_scheduler_function_arn}",
        "Payload": {
          "role": "peer",
          "enabled": false,
          "dry_run": "{% $states.context.Execution.Input.dry_run %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["RetryableError"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["ContinuableError"],
          "Next": "CheckAll",
          "Output": { "fenceSchedulerError": "{% $states.errorOutput %}" }
        }
      ],
      "Next": "CheckAll"
    },

    "CheckAll": {
      "Comment": "観測系 7 本を並列実行する。各分岐で Catch して Pass に落とすことで、1 本が失敗しても他の分岐が最後まで走り、7 件すべての結果が揃う。Catch を付けないと最初に失敗した分岐で他が停止し、何がダメだったのか一度に把握できない。",
      "Type": "Parallel",
      "Next": "AllReady?",
      "Branches": [

        {
          "StartAt": "CheckApiGw",
          "States": {
            "CheckApiGw": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": { "FunctionName": "${dr_check_apigw_function_arn}", "Payload": {} },
              "Retry": [
                { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 30, "BackoffRate": 1.0, "MaxAttempts": 10 }
              ],
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "Next": "ApiGwNg", "Output": "{% $states.errorOutput %}" }
              ],
              "Next": "ApiGwOk"
            },
            "ApiGwOk": { "Type": "Pass", "Output": { "check": "apigw", "ready": true }, "End": true },
            "ApiGwNg": {
              "Type": "Pass",
              "Output": { "check": "apigw", "ready": false, "cause": "{% $states.input.Cause %}" },
              "End": true
            }
          }
        },

        {
          "StartAt": "CheckLambda",
          "States": {
            "CheckLambda": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": { "FunctionName": "${dr_check_lambda_function_arn}", "Payload": {} },
              "Retry": [
                { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 30, "BackoffRate": 1.0, "MaxAttempts": 10 }
              ],
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "Next": "LambdaNg", "Output": "{% $states.errorOutput %}" }
              ],
              "Next": "LambdaOk"
            },
            "LambdaOk": { "Type": "Pass", "Output": { "check": "lambda", "ready": true }, "End": true },
            "LambdaNg": {
              "Type": "Pass",
              "Output": { "check": "lambda", "ready": false, "cause": "{% $states.input.Cause %}" },
              "End": true
            }
          }
        },

        {
          "StartAt": "CheckDynamoDb",
          "States": {
            "CheckDynamoDb": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": { "FunctionName": "${dr_check_dynamodb_function_arn}", "Payload": {} },
              "Retry": [
                { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 30, "BackoffRate": 1.0, "MaxAttempts": 10 }
              ],
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "Next": "DynamoDbNg", "Output": "{% $states.errorOutput %}" }
              ],
              "Next": "DynamoDbOk"
            },
            "DynamoDbOk": { "Type": "Pass", "Output": { "check": "dynamodb", "ready": true }, "End": true },
            "DynamoDbNg": {
              "Type": "Pass",
              "Output": { "check": "dynamodb", "ready": false, "cause": "{% $states.input.Cause %}" },
              "End": true
            }
          }
        },

        {
          "StartAt": "CheckNlb",
          "States": {
            "CheckNlb": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": { "FunctionName": "${dr_check_nlb_function_arn}", "Payload": {} },
              "Retry": [
                { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 30, "BackoffRate": 1.0, "MaxAttempts": 10 }
              ],
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "Next": "NlbNg", "Output": "{% $states.errorOutput %}" }
              ],
              "Next": "NlbOk"
            },
            "NlbOk": { "Type": "Pass", "Output": { "check": "nlb", "ready": true }, "End": true },
            "NlbNg": {
              "Type": "Pass",
              "Output": { "check": "nlb", "ready": false, "cause": "{% $states.input.Cause %}" },
              "End": true
            }
          }
        },

        {
          "StartAt": "CheckS3",
          "States": {
            "CheckS3": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": { "FunctionName": "${dr_check_s3_function_arn}", "Payload": {} },
              "Retry": [
                { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 30, "BackoffRate": 1.0, "MaxAttempts": 10 }
              ],
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "Next": "S3Ng", "Output": "{% $states.errorOutput %}" }
              ],
              "Next": "S3Ok"
            },
            "S3Ok": { "Type": "Pass", "Output": { "check": "s3", "ready": true }, "End": true },
            "S3Ng": {
              "Type": "Pass",
              "Output": { "check": "s3", "ready": false, "cause": "{% $states.input.Cause %}" },
              "End": true
            }
          }
        },

        {
          "StartAt": "CheckAlarms",
          "States": {
            "CheckAlarms": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": { "FunctionName": "${dr_check_alarms_function_arn}", "Payload": {} },
              "Retry": [
                { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 30, "BackoffRate": 1.0, "MaxAttempts": 10 }
              ],
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "Next": "AlarmsNg", "Output": "{% $states.errorOutput %}" }
              ],
              "Next": "AlarmsOk"
            },
            "AlarmsOk": { "Type": "Pass", "Output": { "check": "alarms", "ready": true }, "End": true },
            "AlarmsNg": {
              "Type": "Pass",
              "Output": { "check": "alarms", "ready": false, "cause": "{% $states.input.Cause %}" },
              "End": true
            }
          }
        },

        {
          "StartAt": "CheckWorkload",
          "States": {
            "CheckWorkload": {
              "Comment": "NLB のヘルスチェックは TCP のため、Pod の Ready 判定はこちらが担う。NLB と両方 ready であることを条件にする。",
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": { "FunctionName": "${dr_check_workload_function_arn}", "Payload": {} },
              "Retry": [
                { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 30, "BackoffRate": 1.0, "MaxAttempts": 10 }
              ],
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "Next": "WorkloadNg", "Output": "{% $states.errorOutput %}" }
              ],
              "Next": "WorkloadOk"
            },
            "WorkloadOk": { "Type": "Pass", "Output": { "check": "workload", "ready": true }, "End": true },
            "WorkloadNg": {
              "Type": "Pass",
              "Output": { "check": "workload", "ready": false, "cause": "{% $states.input.Cause %}" },
              "End": true
            }
          }
        }

      ]
    },

    "AllReady?": {
      "Comment": "Parallel の出力は分岐ごとの結果を順に並べた配列。JSONata なら配列の全要素判定が 1 行で書ける。",
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $not(false in $states.input.ready) %}",
          "Next": "ActivateScheduler"
        }
      ],
      "Default": "NotReady"
    },

    "NotReady": {
      "Comment": "どの確認が NG だったかは Parallel の出力配列にすべて残っている。開放していないので旧 ACTIVE 側は閉塞されたままである点に注意。",
      "Type": "Fail",
      "Error": "NotReady",
      "Cause": "One or more readiness checks did not pass. See the Parallel state output for details."
    },

    "ActivateScheduler": {
      "Comment": "新 ACTIVE（SELF）を開放する。ここからの失敗は Catch しない（切替不成立のため停止させる）。",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_scheduler_function_arn}",
        "Payload": {
          "role": "self",
          "enabled": true,
          "dry_run": "{% $states.context.Execution.Input.dry_run %}"
        }
      },
      "Retry": [
        { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 5, "BackoffRate": 2, "MaxAttempts": 3 }
      ],
      "Next": "ActivateApiGw"
    },

    "ActivateApiGw": {
      "Comment": "スロットリングを通常値へ戻す。throttle を指定しなければ Lambda の環境変数の値が使われる。",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_apigw_function_arn}",
        "Payload": {
          "role": "self",
          "blocked": false,
          "dry_run": "{% $states.context.Execution.Input.dry_run %}"
        }
      },
      "Retry": [
        { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 5, "BackoffRate": 2, "MaxAttempts": 3 }
      ],
      "Next": "VerifyAfterActivate"
    },

    "VerifyAfterActivate": {
      "Comment": "開放が効いたことを実リクエストで確認する。スロットリングが 0 のままなら 429 が返るため RetryableError になり、ここで再試行される。",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": { "FunctionName": "${dr_check_apigw_function_arn}", "Payload": {} },
      "Retry": [
        { "ErrorEquals": ["RetryableError"], "IntervalSeconds": 15, "BackoffRate": 1.0, "MaxAttempts": 8 }
      ],
      "End": true
    }

  }
}
