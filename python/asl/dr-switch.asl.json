{
  "Comment": "DR 切替。閉塞 -> DNS 切替 -> 開放 -> 確認の順で進める。\n閉塞は best_effort（旧リージョンが落ちていれば失敗しうる）なので ContinuableError を Catch して先へ進む。開放と確認は失敗したら止める。\nDNS 切替を閉塞の後・開放の前に置くのは、先に切り替えるとまだ開放して いない切替先へトラフィックが向くため。\n\nPod 再起動は 2 方式ある。ここでは Kubernetes API を直接叩く rollout_restart を使う。既存 Lambda を呼ぶ restart_pods を使う場合は FunctionName を dr_eks_restart_pods_function_arn に差し替える。呼ばれる側が完了を待つため、その分 RTO が伸びる。",
  "QueryLanguage": "JSONata",
  "StartAt": "FenceApiGateway",
  "States": {
    "FenceApiGateway": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_apigateway_block_function_arn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "RetryableError"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1.0,
          "MaxAttempts": 10
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "ContinuableError"
          ],
          "Next": "FenceScheduler",
          "Output": "{% $states.input %}"
        }
      ],
      "Next": "FenceScheduler"
    },
    "FenceScheduler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_scheduler_block_function_arn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "RetryableError"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1.0,
          "MaxAttempts": 10
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "ContinuableError"
          ],
          "Next": "FenceS3",
          "Output": "{% $states.input %}"
        }
      ],
      "Next": "FenceS3"
    },
    "FenceS3": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_s3_block_function_arn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "RetryableError"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1.0,
          "MaxAttempts": 10
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "ContinuableError"
          ],
          "Next": "SwitchDns",
          "Output": "{% $states.input %}"
        }
      ],
      "Next": "SwitchDns"
    },
    "SwitchDns": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_route53_switch_function_arn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "RetryableError"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1.0,
          "MaxAttempts": 10
        }
      ],
      "Next": "RestartWorkloads"
    },
    "RestartWorkloads": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_eks_rollout_restart_function_arn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "RetryableError"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1.0,
          "MaxAttempts": 10
        }
      ],
      "Next": "ActivateS3"
    },
    "ActivateS3": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_s3_enable_function_arn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "RetryableError"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1.0,
          "MaxAttempts": 10
        }
      ],
      "Next": "ActivateScheduler"
    },
    "ActivateScheduler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_scheduler_enable_function_arn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "RetryableError"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1.0,
          "MaxAttempts": 10
        }
      ],
      "Next": "ActivateApiGateway"
    },
    "ActivateApiGateway": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${dr_apigateway_enable_function_arn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "RetryableError"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1.0,
          "MaxAttempts": 10
        }
      ],
      "Next": "CheckAll"
    },
    "CheckAll": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "CheckApiGateway",
          "States": {
            "CheckApiGateway": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_apigateway_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "ApiGatewayNg",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "ApiGatewayOk"
            },
            "ApiGatewayOk": {
              "Type": "Pass",
              "Output": {
                "check": "apigateway",
                "ready": true
              },
              "End": true
            },
            "ApiGatewayNg": {
              "Type": "Pass",
              "Output": {
                "check": "apigateway",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckScheduler",
          "States": {
            "CheckScheduler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_scheduler_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "SchedulerNg",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "SchedulerOk"
            },
            "SchedulerOk": {
              "Type": "Pass",
              "Output": {
                "check": "scheduler",
                "ready": true
              },
              "End": true
            },
            "SchedulerNg": {
              "Type": "Pass",
              "Output": {
                "check": "scheduler",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckS3",
          "States": {
            "CheckS3": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_s3_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "S3Ng",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "S3Ok"
            },
            "S3Ok": {
              "Type": "Pass",
              "Output": {
                "check": "s3",
                "ready": true
              },
              "End": true
            },
            "S3Ng": {
              "Type": "Pass",
              "Output": {
                "check": "s3",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckRoute53",
          "States": {
            "CheckRoute53": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_route53_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "Route53Ng",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "Route53Ok"
            },
            "Route53Ok": {
              "Type": "Pass",
              "Output": {
                "check": "route53",
                "ready": true
              },
              "End": true
            },
            "Route53Ng": {
              "Type": "Pass",
              "Output": {
                "check": "route53",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckLambda",
          "States": {
            "CheckLambda": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_lambda_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "LambdaNg",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "LambdaOk"
            },
            "LambdaOk": {
              "Type": "Pass",
              "Output": {
                "check": "lambda",
                "ready": true
              },
              "End": true
            },
            "LambdaNg": {
              "Type": "Pass",
              "Output": {
                "check": "lambda",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckDynamoDb",
          "States": {
            "CheckDynamoDb": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_dynamodb_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "DynamoDbNg",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "DynamoDbOk"
            },
            "DynamoDbOk": {
              "Type": "Pass",
              "Output": {
                "check": "dynamodb",
                "ready": true
              },
              "End": true
            },
            "DynamoDbNg": {
              "Type": "Pass",
              "Output": {
                "check": "dynamodb",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckNlb",
          "States": {
            "CheckNlb": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_nlb_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "NlbNg",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "NlbOk"
            },
            "NlbOk": {
              "Type": "Pass",
              "Output": {
                "check": "nlb",
                "ready": true
              },
              "End": true
            },
            "NlbNg": {
              "Type": "Pass",
              "Output": {
                "check": "nlb",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckCloudwatch",
          "States": {
            "CheckCloudwatch": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_cloudwatch_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "CloudwatchNg",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "CloudwatchOk"
            },
            "CloudwatchOk": {
              "Type": "Pass",
              "Output": {
                "check": "cloudwatch",
                "ready": true
              },
              "End": true
            },
            "CloudwatchNg": {
              "Type": "Pass",
              "Output": {
                "check": "cloudwatch",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckEfs",
          "States": {
            "CheckEfs": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_efs_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "EfsNg",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "EfsOk"
            },
            "EfsOk": {
              "Type": "Pass",
              "Output": {
                "check": "efs",
                "ready": true
              },
              "End": true
            },
            "EfsNg": {
              "Type": "Pass",
              "Output": {
                "check": "efs",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "CheckEks",
          "States": {
            "CheckEks": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "FunctionName": "${dr_eks_check_function_arn}",
                "Payload": {}
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "RetryableError"
                  ],
                  "IntervalSeconds": 30,
                  "BackoffRate": 1.0,
                  "MaxAttempts": 10
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Next": "EksNg",
                  "Output": "{% $states.errorOutput %}"
                }
              ],
              "Next": "EksOk"
            },
            "EksOk": {
              "Type": "Pass",
              "Output": {
                "check": "eks",
                "ready": true
              },
              "End": true
            },
            "EksNg": {
              "Type": "Pass",
              "Output": {
                "check": "eks",
                "ready": false,
                "cause": "{% $states.input.Cause %}"
              },
              "End": true
            }
          }
        }
      ],
      "Next": "AllReady?"
    },
    "AllReady?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $not(false in $states.input.ready) %}",
          "Next": "Succeeded"
        }
      ],
      "Default": "NotReady"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "NotReady": {
      "Type": "Fail",
      "Error": "NotReady",
      "Cause": "1 つ以上の確認が通らなかった。実行履歴の CheckAll を参照"
    }
  }
}
